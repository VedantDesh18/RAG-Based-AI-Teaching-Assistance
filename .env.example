# ==============================================================================
# RAG-Based AI Teaching Assistant - Environment Configuration
# ==============================================================================

# Ollama API URL
# Inside Docker on Windows/macOS/Linux, host.docker.internal reaches the host machine's Ollama instance.
# If running an Ollama container via Docker Compose, set: http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434

# LLM Provider Configuration (gemini | ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Model Names (for Ollama fallback & local embeddings)
EMBEDDING_MODEL=bge-m3:latest
LLM_MODEL=llama3.2


# Whisper Speech-to-Text Configuration
# Options: tiny, base, small, medium, large-v2, large-v3
# `base` is a memory-friendly default for CPU uploads. Increase it only if the
# host has enough memory and you need the extra transcription accuracy.
WHISPER_MODEL=base
# Options: cpu, cuda
WHISPER_DEVICE=cpu
# Options: int8, float16 (for cuda), float32
WHISPER_COMPUTE_TYPE=int8
# Greedy decoding has the lowest memory usage; increase only when needed.
WHISPER_BEAM_SIZE=1
# Bound CTranslate2's own worker pool in addition to the MKL/OpenMP limits.
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=1
# Transcribe longer recordings in bounded pieces to control peak memory.
WHISPER_MAX_SEGMENT_SEC=600
# Limit CPU thread pools used by CTranslate2/MKL on constrained machines.
MKL_NUM_THREADS=2
OMP_NUM_THREADS=2
# Send text to Ollama in bounded batches while indexing.
EMBEDDING_BATCH_SIZE=16

# FastAPI Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
VIDEOQA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Next.js Frontend Settings
FRONTEND_PORT=3000
# Internal Docker URL used by Next.js rewrites to communicate with the backend
BACKEND_URL=http://backend:8000
# Optional: Direct public API URL if bypassing Next.js rewrites. Leave blank to proxy via Next.js
NEXT_PUBLIC_API_URL=

# Data & Persistence Paths
CHROMA_PATH=data/chroma
DB_PATH=data/db/videoqa.db
MEDIA_ROOT=data/media
LEGACY_MEDIA_ROOT=videos
